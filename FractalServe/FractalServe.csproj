<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FractalBltEncoder\FractalBltEncoder.csproj" />
    <ProjectReference Include="..\FractalGnnRouter\FractalGnnRouter.csproj" />
    <ProjectReference Include="..\FractalBridge\FractalBridge.csproj" />
    <ProjectReference Include="..\FractalStreamer\FractalStreamer.csproj" />
    <ProjectReference Include="..\FractalBLT.Core\FractalBLT.Core.csproj" />
  </ItemGroup>
</Project>
